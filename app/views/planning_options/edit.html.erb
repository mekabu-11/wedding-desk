<%= link_to "← 検討項目", planning_item_path(@option.planning_item), class: "back-link" %><header class="page-heading"><div><h1>候補を編集する</h1><p><%= @option.planning_item.title %></p></div></header><section class="surface narrow"><%= render "shared/errors", record: @option %><%= form_with model: @option, class: "form-stack" do |f| %><%= f.hidden_field :lock_version %><div class="field"><%= f.label :title, "候補名" %><%= f.text_field :title, required: true, maxlength: 150 %></div><div class="field"><%= f.label :description, "説明" %><%= f.text_area :description, rows: 4, maxlength: 3000 %></div><div class="form-grid"><div class="field"><%= f.label :status, "状態" %><% if @option.selected? %><p>採用中（採用操作から変更）</p><% else %><%= f.select :status, PlanningOption::STATUSES.except("selected").map { |k,v| [v,k] }, {}, required: true %><% end %></div><div class="field"><%= f.label :reference_price_yen, "参考価格（円）" %><%= f.number_field :reference_price_yen, min: 0, step: 1 %></div></div><%= f.submit "保存する", class: "button primary" %><% end %><%= button_to "この候補を削除", planning_option_path(@option), method: :delete, class: "button danger-button", style: "margin-top:16px" %></section>
