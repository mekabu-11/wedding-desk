<%= link_to "← やること", tasks_path, class: "back-link" %>
<header class="page-heading"><div><h1>タスクを確認する</h1><p>期限や担当を調整して、ひとつずつ進めましょう。</p></div></header>
<div class="review-grid">
<section class="surface"><%= render "form", task: @task %></section>
<aside><h2>このタスクの出典</h2>
<% if @task.candidate %>
<blockquote><%= @task.candidate.evidence['quote'] %></blockquote>
<%= link_to @task.candidate.document.title + ' →', document_path(@task.candidate.document), class: "text-link" %>
<% elsif @task.origin == 'import' %>
<% source = @task.source_details || {} %>
<blockquote><%= source['source_file'] %><br><%= source['source_sheet'] %>・<%= source['source_row'] %>行目<br>元の担当：<%= source['assignee_raw'].presence || '空欄' %><br>元のカテゴリ：<%= source['category_raw'].presence || '空欄' %></blockquote>
<% elsif @task.origin == 'ai' %>
<% source = @task.source_details || {} %>
<blockquote>元資料は削除済みです。<% if source['source_title'].present? %><br>資料名：<%= source['source_title'] %><% end %><% if source['source_occurred_at'].present? %><br>資料日時：<%= l Time.zone.parse(source['source_occurred_at']), format: :default %><% end %></blockquote>
<% else %><p class="muted">手動で追加したタスクです。</p><% end %>
<p class="micro">手動で変更した内容は、再解析や同じ出典の再取り込みで上書きされません。</p>
</aside></div>
<section class="surface" style="margin-top:24px"><h2>関連する検討項目</h2><% @task_planning_links.each do |link| %><p><%= link_to link.planning_item.title, planning_item_path(link.planning_item) %> <%= button_to "解除", task_planning_link_path(link), method: :delete, class: "button secondary" %></p><% end %><%= form_with url: task_planning_links_path, method: :post, class: "form-grid" do |f| %><%= hidden_field_tag :task_id, @task.id %><div class="field"><%= label_tag :planning_item_id, "検討項目を追加" %><%= select_tag :planning_item_id, options_for_select([["選択してください", ""]] + @planning_items.map { |item| [item.title, item.id] }), required: true %></div><%= f.submit "追加", class: "button secondary" %><% end %></section>
