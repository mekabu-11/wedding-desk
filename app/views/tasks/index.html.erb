<header class="page-heading"><div><h1><span class="page-title"><%= ui_icon(:tasks, size: 25) %><span>やること</span></span></h1><p>準備を追加して、期限の近い順に進めましょう。</p></div><div class="task-actions"><%= link_to "Excelをまとめて移行", new_spreadsheet_import_path, class: "button secondary" %><%= link_to new_task_path, class: "button primary" do %><%= ui_icon(:plus, size: 17) %><span>タスクを追加</span><% end %></div></header>
<div class="task-toolbar">
<%= form_with url: tasks_path, method: :get, class: "task-filters surface" do |f| %>
<div class="field"><%= f.label :status, "状態" %><%= f.select :status, [['これから', '']] + Task::STATUSES.map { |k,v| [v,k] }, selected: @status %></div>
<div class="field"><%= f.label :assignee, "担当" %><%= f.select :assignee, [['全員', '']] + @assignee_options, selected: @assignee %></div>
<div class="field"><%= f.label :category, "カテゴリ" %><%= f.select :category, [['すべて', '']] + Task::CATEGORIES.map { |k,v| [v,k] }, selected: @category %></div>
<div class="field"><%= f.label :period, "期間" %><%= f.select :period, [['すべて', ''], ['今週やること', 'week'], ['期限超過', 'overdue']], selected: @period %></div>
<div class="field"><%= f.label :q, "文字検索" %><%= f.search_field :q, value: @query, placeholder: "タイトル・詳細" %></div>
<%= f.submit "絞り込む", class: "button secondary" %>
<% end %>
<div class="task-actions"><%= link_to "一覧", tasks_path(request.query_parameters.except("view")), class: "button #{@view == 'list' ? 'primary' : 'secondary'}" %><%= link_to "ガント", tasks_path(request.query_parameters.merge(view: "gantt")), class: "button #{@view == 'gantt' ? 'primary' : 'secondary'}" %><%= form_with url: bulk_preview_tasks_path, method: :post, class: "inline-form" do %><%= hidden_field_tag :selection, "filtered" %><%= hidden_field_tag :q, @query %><%= hidden_field_tag :status, @status %><%= hidden_field_tag :assignee, @assignee %><%= hidden_field_tag :category, @category %><%= hidden_field_tag :period, @period %><%= submit_tag "絞り込み結果を一括変更", class: "button secondary", disabled: @search_limit_exceeded %><% end %></div>
<% if @search_limit_exceeded %><p class="flash flash-alert">文字検索の対象が2000件を超えています。安全に検索するため、状態・担当・カテゴリ・期間で対象を絞ってください。</p><% end %>
<p class="muted task-result-count"><%= @total_count %>件<%= ' · 今週に期間が重なるタスク。開始日なしは今週期限のものを表示。' if @period == 'week' %></p>
</div>
<% if @view == "list" %>
<%= form_with url: bulk_preview_tasks_path, method: :post do %>
<div class="task-list-scroll">
<section class="surface list-surface">
<% if @tasks.empty? %><div class="empty-state"><h2>該当するタスクはありません</h2><p>タスクを追加するか、絞り込み条件を変更してください。</p></div><% end %>
<% @tasks.each do |task| %><div class="task-select-row"><%= check_box_tag "task_ids[]", task.id, false, aria: { label: "#{task.title}を選択" } %><%= render "row", task: task %><%= hidden_field_tag "versions[#{task.id}]", task.lock_version %></div><% end %>
</section>
</div>
<div class="task-actions"><%= submit_tag "現在のページを一括変更", class: "button secondary" %><small>チェックした現在ページのタスクだけが対象です。</small></div>
<% end %>
<%= render "shared/pagination", total: @total_count, page: @page %>
<% else %>
  <%= render "gantt" %>
<% end %>
