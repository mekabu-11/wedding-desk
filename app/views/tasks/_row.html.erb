<%= link_to edit_task_path(task), class: "task-row" do %><% unless local_assigns.fetch(:hide_status_check, false) %><span class="task-check <%= 'done' if task.status == 'done' %>"><%= task.status == 'done' ? '✓' : '' %></span><% end %><div class="row-content"><h3><%= task.title %></h3><div class="row-meta-text"><span class="<%= 'overdue' if task.overdue? %>"><%= deadline_label(task) %><%= ' · 期限超過' if task.overdue? %></span> · <%= task.assignee_label %></div></div><%= status_badge Task::STATUSES.fetch(task.status, task.status), tone: task_status_tone(task.status) %><span class="row-arrow">→</span><% end %>
