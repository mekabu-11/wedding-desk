<%= link_to edit_task_path(task), class: "task-row" do %><span class="task-check <%= 'done' if task.status == 'done' %>"><%= task.status == 'done' ? '✓' : '' %></span><div class="row-content"><h3><%= task.title %></h3><div class="micro"><span class="<%= 'overdue' if task.overdue? %>"><%= deadline_label(task) %><%= ' · 期限超過' if task.overdue? %></span><span class="separator">/</span><%= Task::ASSIGNEES[task.assignee] %></div></div><span class="badge <%= task.status == 'doing' ? 'amber' : 'muted' %>"><%= Task::STATUSES[task.status] %></span><span class="row-arrow">→</span><% end %>
