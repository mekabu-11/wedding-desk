<%= render "shared/errors", record: meal_set %><%= form_with model: meal_set, class: "form-stack" do |f| %><%= f.hidden_field :lock_version %><div class="field"><%= f.label :name, "セット名" %><%= f.text_field :name, required: true, maxlength: 120, placeholder: "例：標準コース" %></div><div class="form-grid"><div class="field"><%= f.label :target_age_group, "適用対象" %><%= f.select :target_age_group, MealSet::TARGET_AGE_GROUPS.map { |k,v| [v,k] } %></div><div class="field"><%= f.label :unit_price_yen, "1人あたりの金額（円）" %><%= f.number_field :unit_price_yen, required: true, min: 0, step: 1 %></div></div><label class="check-label"><%= f.check_box :default_for_target %><span>この対象の標準セットにする（出席ゲストへ自動適用）</span></label><div class="field"><%= f.label :notes, "メモ" %><%= f.text_area :notes, rows: 3, maxlength: 1000 %></div><%= f.submit meal_set.persisted? ? "保存する" : "食事セットを追加", class: "button primary" %><% end %>
