<!DOCTYPE html>
<html lang="ja">
<head>
  <title><%= content_for(:title) || "Wedding Desk" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <%= csrf_meta_tags %><%= csp_meta_tag %>
  <%= stylesheet_link_tag "application" %>
  <%= javascript_include_tag "application", defer: true %>
  <%= yield :head %>
</head>
<body>
<% if current_user && current_wedding %>
  <aside class="sidebar" data-mobile-sidebar>
    <div class="sidebar-head">
      <%= link_to root_path, class: "brand" do %><span class="brand-mark">w.</span><span class="brand-copy">Wedding Desk</span><% end %>
      <div class="sidebar-head-tools">
        <button type="button" class="sidebar-toggle" data-sidebar-toggle aria-expanded="true" aria-label="サイドバーを折りたたむ"><span aria-hidden="true">‹</span></button>
        <button type="button" class="mobile-menu-toggle" data-mobile-menu-toggle aria-expanded="false" aria-controls="primary-navigation" aria-label="メニューを開く"><span aria-hidden="true">☰</span></button>
      </div>
    </div>
    <div class="sidebar-label">ふたりの準備</div>
    <nav id="primary-navigation" data-mobile-nav aria-label="メインナビゲーション">
      <%= nav_link("ダッシュボード", root_path, controller_name == "dashboard", icon: :overview) %>
      <%= nav_link("資料と連絡", documents_path, controller_name.in?(%w[documents candidates]), icon: :documents) %>
      <%= nav_link("やること", tasks_path, controller_name == "tasks", icon: :tasks) %>
      <%= nav_link("ゲスト", guests_path, controller_name.in?(%w[guests households seating_tables cash_gift_rules gift_sets gift_assignments]), icon: :guests) %>
      <%= nav_link("お金", budget_items_path, controller_name.in?(%w[budget_items money_movements]), icon: :money) %>
      <%= nav_link("検討・決定", planning_items_path, controller_name.in?(%w[planning_items planning_options music_details planning_cost_links task_planning_links]), icon: :planning) %>
    </nav>
    <%= link_to "＋ まとめて登録", new_document_path, class: "button primary sidebar-create" %>
    <div class="sidebar-bottom">
      <div class="wedding-mini"><span class="wedding-mini-label">結婚式</span><strong><%= current_wedding.name %></strong><span class="wedding-mini-date"><span>挙式日</span><% if current_wedding.wedding_date %><time datetime="<%= current_wedding.wedding_date.iso8601 %>"><%= current_wedding.wedding_date.strftime("%Y年%-m月%-d日") %></time><% else %><span>未設定</span><% end %></span></div>
      <%= nav_link("ヘルプ", help_path, controller_name == "help", icon: :help) %>
      <%= nav_link("結婚式の設定", edit_wedding_path, controller_name == "weddings", icon: :settings) %>
      <%= button_to "ログアウト", session_path, method: :delete, class: "logout" %>
    </div>
  </aside>
  <button type="button" class="mobile-menu-backdrop" data-mobile-menu-close aria-label="メニューを閉じる" hidden></button>
<% end %>
<main class="<%= current_user && current_wedding ? 'main' : 'standalone' %>" id="main">
  <% flash.each do |type, message| %><div class="flash <%= type == 'alert' ? 'flash-alert' : '' %>" role="<%= type == 'alert' ? 'alert' : 'status' %>"><%= message %></div><% end %>
  <%= yield %>
</main>
</body>
</html>
