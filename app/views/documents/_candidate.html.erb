<% data = candidate.payload %><article class="surface candidate <%= 'reviewed' if candidate.review_status != 'pending' %>" id="candidate-<%= candidate.id %>">
<div class="candidate-heading"><span class="micro">候補 <%= format('%02d', index + 1) %></span><span class="badge <%= candidate.review_status == 'accepted' ? 'green' : 'muted' %>"><%= { 'pending' => '未確認', 'accepted' => '反映済み', 'rejected' => '見送り' }[candidate.review_status] %></span></div>
<% if candidate.review_status == 'pending' %>
<%= form_with url: document_candidate_path(@document, candidate), method: :patch, scope: :task, class: "form-stack" do |f| %>
  <div class="field"><%= f.label :title, "やること", for: "candidate_#{candidate.id}_title" %><%= f.text_field :title, value: data['title'], required: true, maxlength: 150, id: "candidate_#{candidate.id}_title" %></div>
  <blockquote><p><%= candidate.evidence['quote'] %></p><cite>原文より</cite></blockquote>
  <div class="form-grid"><div class="field"><%= f.label :due_on, "期限日", for: "candidate_#{candidate.id}_due_on" %><%= f.date_field :due_on, value: data['due_on'], id: "candidate_#{candidate.id}_due_on" %></div><div class="field"><%= f.label :assignee, "担当", for: "candidate_#{candidate.id}_assignee" %><%= f.select :assignee, Task.assignee_options(@document.wedding), { selected: Task.normalize_assignee(data['assignee']) }, id: "candidate_#{candidate.id}_assignee" %></div></div>
  <% if data['due_at'].present? %><div class="field"><%= f.label :due_at, "時刻付き期限（日本時間・期限日とは片方だけ）", for: "candidate_#{candidate.id}_due_at" %><%= f.datetime_local_field :due_at, value: Time.iso8601(data['due_at']).in_time_zone.strftime('%Y-%m-%dT%H:%M'), id: "candidate_#{candidate.id}_due_at" %></div><% end %>
  <% if data['uncertainty_reasons'].any? %><ul class="review-notes"><% data['uncertainty_reasons'].each do |reason| %><li><%= reason %></li><% end %></ul><% end %>
  <details><summary>詳細・カテゴリを編集</summary><div class="field"><%= f.label :description, "詳細", for: "candidate_#{candidate.id}_description" %><%= f.text_area :description, value: data['description'], rows: 3, id: "candidate_#{candidate.id}_description" %></div><div class="field"><%= f.label :category, "カテゴリ", for: "candidate_#{candidate.id}_category" %><%= f.select :category, Task::CATEGORIES.map { |k,v| [v,k] }, { selected: data['category'] }, id: "candidate_#{candidate.id}_category" %></div></details>
  <label class="check-label"><%= check_box_tag :confirmed, "1", false, required: true, id: "confirm_#{candidate.id}" %>原文と期限・担当を確認しました</label>
  <%= button_tag "確認してタスクに追加", name: "decision", value: "accept", class: "button primary full" %>
<% end %>
<%= button_to "この候補を見送る", document_candidate_path(@document, candidate), method: :patch, params: { decision: "reject" }, class: "dismiss-button" %>
<% else %><h3><%= candidate.task&.title || data['title'] %></h3><p class="micro"><%= candidate.review_status == 'accepted' ? '確認した内容をタスク一覧に反映しました。' : 'この候補はタスクに追加していません。' %></p><% if candidate.task %><%= link_to "タスクを確認・編集 →", edit_task_path(candidate.task), class: "text-link" %><% end %><details><summary>抽出時の根拠を見る</summary><blockquote><%= candidate.evidence['quote'] %></blockquote></details><% end %></article>
