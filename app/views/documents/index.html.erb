<header class="page-heading"><div><p class="eyebrow">受け取った連絡</p><h1><span class="page-title"><%= ui_icon(:documents, size: 25) %><span>資料と連絡</span></span></h1><p>原文と整理された内容を、いつでも見返せる場所。</p></div><%= link_to new_document_path, class: "button primary" do %><%= ui_icon(:plus, size: 17) %><span>連絡を登録</span><% end %></header>
<nav class="tabs" aria-label="情報元で絞り込み"><%= link_to "すべて", documents_path, class: @source.nil? ? "selected" : "" %><% Document::SOURCES.each do |key, label| %><%= link_to label, documents_path(source: key), class: @source == key ? "selected" : "" %><% end %></nav>
<section class="surface list-surface"><% if @documents.empty? %><div class="empty-state"><span class="empty-symbol"><%= ui_icon(:documents, size: 25) %></span><h2>まだ資料がありません</h2><p>届いたメールやLINEを貼り付けて、準備を整理しましょう。</p><%= link_to "最初の連絡を登録", new_document_path, class: "button primary" %></div><% end %>
<% @documents.each do |doc| %><% label, tone = document_status(doc) %><%= link_to doc, class: "document-row" do %><span class="document-icon"><%= ui_icon(:document, size: 20) %></span><div class="row-content"><div class="micro"><%= Document::SOURCES.fetch(doc.source_type, "資料") %><%= " / サンプル" if doc.sample? %> · <%= doc.occurred_at ? doc.occurred_at.strftime("%Y/%m/%d の連絡") : doc.created_at.strftime("%Y/%m/%d 登録") %></div><h3><%= doc.title %></h3><p><%= doc.latest_run&.summary&.truncate(90) || "原文を保存しています" %></p></div><span class="badge <%= tone %>"><%= label %></span><span class="row-arrow">→</span><% end %><% end %></section>
<%= render "shared/pagination", total: @total_count, page: @page %>
