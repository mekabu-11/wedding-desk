<header class="page-heading"><div><p class="eyebrow">受け取った連絡</p><h1><span class="page-title"><%= ui_icon(:documents, size: 25) %><span>資料と連絡</span></span></h1><p>原文と整理された内容を、いつでも見返せる場所。</p></div><%= link_to new_document_path, class: "button primary" do %><%= ui_icon(:plus, size: 17) %><span>連絡を登録</span><% end %></header>
<nav class="tabs" aria-label="入力形式で絞り込み"><%= link_to "すべて", documents_path(origin: @origin, direction: @direction), class: @media.nil? ? "selected" : "" %><% Document::MEDIA_FILTERS.each do |key, filter| %><%= link_to filter.fetch(:label), documents_path(media: key, origin: @origin, direction: @direction), class: @media == key ? "selected" : "" %><% end %></nav>
<% active_filters = [@origin, @direction].count(&:present?) %><details class="filter-disclosure" <%= "open" if active_filters.positive? %>><summary>絞り込み<% if active_filters.positive? %><span class="filter-count"><%= active_filters %>件適用中</span><% end %></summary><%= form_with url: documents_path, method: :get, class: "filter-form" do |f| %><%= hidden_field_tag :media, @media %><div class="field"><%= f.label :origin, "情報元" %><%= f.select :origin, [["すべて", ""]] + Document::ORIGIN_FILTERS.map { |k, v| [v.fetch(:label), k] }, selected: @origin %></div><div class="field"><%= f.label :direction, "やり取り" %><%= f.select :direction, [["すべて", ""]] + Document::DIRECTIONS.map { |k, v| [v, k] }, selected: @direction %></div><div class="filter-actions"><%= f.submit "絞り込む", class: "button secondary" %><%= link_to "条件をクリア", documents_path(media: @media), class: "text-link" if active_filters.positive? %></div><% end %></details>
<section class="surface list-surface"><% if @documents.empty? %><div class="empty-state"><span class="empty-symbol"><%= ui_icon(:documents, size: 25) %></span><h2>まだ資料がありません</h2><p>文章や写真・PDFをそのまま登録して、準備を整理しましょう。</p><%= link_to "最初の連絡を登録", new_document_path, class: "button primary" %></div><% end %>
<% @documents.each do |doc| %><% label, tone = document_status(doc) %><%= link_to doc, class: "document-row" do %><span class="document-icon"><%= ui_icon(:document, size: 20) %></span><div class="row-content"><div class="micro"><%= document_source_label(doc) %><%= " / サンプル" if doc.sample? %> · <%= doc.occurred_at ? doc.occurred_at.strftime("%Y/%m/%d の連絡") : doc.created_at.strftime("%Y/%m/%d 登録") %></div><h3><%= doc.title %></h3><p><%= doc.latest_run&.summary&.truncate(90) || "原文を保存しています" %></p></div><span class="badge <%= tone %>"><%= label %></span><span class="row-arrow">→</span><% end %><% end %></section>
<%= render "shared/pagination", total: @total_count, page: @page %>
