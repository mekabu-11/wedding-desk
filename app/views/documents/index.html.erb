<header class="page-heading"><div><p class="eyebrow">YOUR INBOX</p><h1>資料と連絡</h1><p>原文と整理された内容を、いつでも見返せる場所。</p></div><%= link_to "＋ 連絡を登録", new_document_path, class: "button primary" %></header>
<nav class="tabs" aria-label="情報元で絞り込み"><%= link_to "すべて", documents_path, class: @source.nil? ? "selected" : "" %><% Document::SOURCES.each do |key, label| %><%= link_to label, documents_path(source: key), class: @source == key ? "selected" : "" %><% end %></nav>
<section class="surface list-surface"><% if @documents.empty? %><div class="empty-state"><span class="empty-symbol">≡</span><h2>まだ資料がありません</h2><p>届いたメールやLINEを貼り付けて、準備を整理しましょう。</p><%= link_to "最初の連絡を登録", new_document_path, class: "button primary" %></div><% end %>
<% @documents.each do |doc| %><% label, tone = document_status(doc) %><%= link_to doc, class: "document-row" do %><span class="document-icon">文</span><div class="row-content"><div class="micro"><%= Document::SOURCES[doc.source_type] %><%= " / サンプル" if doc.sample? %> · <%= doc.occurred_at ? doc.occurred_at.strftime("%Y/%m/%d の連絡") : "連絡日不明" %></div><h3><%= doc.title %></h3><p><%= doc.latest_run&.summary&.truncate(90) || "原文を保存しています" %></p></div><span class="badge <%= tone %>"><%= label %></span><span class="row-arrow">→</span><% end %><% end %></section>
<%= render "shared/pagination", total: @total_count, page: @page %>
