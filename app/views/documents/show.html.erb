<% if @run&.active? && @document.pending_candidates.none? %><% content_for :head do %><meta http-equiv="refresh" content="5"><% end %><% end %>
<%= link_to "← 資料と連絡", documents_path, class: "back-link" %><header class="page-heading"><div><p class="eyebrow"><%= Document::SOURCES[@document.source_type] %> / <%= Document::DIRECTIONS[@document.direction] %></p><h1 class="document-title"><%= @document.title %></h1><p><%= @document.occurred_at ? @document.occurred_at.strftime("%Y年%m月%d日 %H:%M の連絡") : "連絡日時は未設定" %><span class="separator">/</span><%= @document.created_at.strftime("%m/%d 登録") %></p></div><%= link_to "やること一覧 →", tasks_path, class: "button secondary" %></header>
<% if @document.sample? %><div class="callout sample-notice"><strong>操作体験用のサンプルです</strong><p>架空の原文と固定の抽出例を使っています。実際のAI解析結果ではありません。</p></div><% end %>
<% if @run&.status == "failed" %><div class="flash flash-alert" role="alert"><%= analysis_error(@run.error_code) %></div><% elsif @run&.active? %><div class="callout" role="status"><strong>連絡を整理しています</strong><p>資料は保存済みです。未確認の候補がない間は5秒ごとに更新します。5分以上止まる場合は再試行できます。</p></div><% end %>
<div class="review-grid"><section class="original-column"><div class="section-heading"><div><p class="eyebrow">SOURCE</p><h2>届いた原文</h2></div><span class="badge muted">保存済み</span></div><div class="surface original-text"><%= @document.original_text %></div><% if @run&.summary.present? %><div class="summary-block"><p class="eyebrow"><%= @document.sample? ? "サンプルの要約" : "AIによる要約" %></p><p><%= @run.summary %></p></div><% end %></section>
<section><div class="section-heading"><div><p class="eyebrow">REVIEW & CONFIRM</p><h2>やることの候補</h2></div><span class="badge amber"><%= @document.pending_candidates.count %>件を確認</span></div>
<% if @candidates.empty? %><div class="surface empty-state"><h3><%= @run&.status == "completed" ? "タスク候補は見つかりませんでした" : "結果はここに表示されます" %></h3><p><%= @run&.status == "completed" ? "抽出漏れがないか原文も確認してください。" : "原文に戻れる形で、期限や担当を整理します。" %></p></div><% end %>
<% @candidates.each_with_index do |candidate, index| %><%= render "candidate", candidate: candidate, index: index %><% end %>
</section></div>
<div class="document-actions"><% if @document.retryable? %><%= button_to "再解析する", retry_analysis_document_path(@document), class: "button secondary" %><span class="micro">確認済みのタスクは上書きしません。</span><% else %><%= link_to "状態を更新", @document, class: "button secondary" %><% end %></div>
<details class="delete-section"><summary>この資料を削除する</summary><p>原文・解析結果・候補と、この資料から作成したタスクも削除します。この操作は取り消せません。</p><%= form_with url: document_path(@document), method: :delete do |f| %><label class="check-label"><%= check_box_tag :confirm_delete, "1", false, required: true %>関連するタスクも削除されることを確認しました</label><%= f.submit "資料と関連タスクを削除", class: "button danger-button" %><% end %></details>
