<%= render "shared/errors", record: @wedding %>
<%= form_with model: @wedding, url: wedding_path, class: "form-stack" do |f| %>
  <div class="field"><%= f.label :name, "結婚式名" %><%= f.text_field :name, required: true, maxlength: 100, placeholder: "私たちの結婚式" %></div>
  <div class="form-grid"><div class="field"><%= f.label :wedding_date, "挙式日" %><%= f.date_field :wedding_date %></div><div class="field"><%= f.label :venue_name, "会場名" %><%= f.text_field :venue_name, placeholder: "未定の場合は空欄で大丈夫です" %></div></div>
  <div class="form-grid"><div class="field"><%= f.label :self_name, "自分の表示名" %><%= f.text_field :self_name, placeholder: "担当の読み取りに使います" %></div><div class="field"><%= f.label :partner_name, "パートナーの表示名" %><%= f.text_field :partner_name %></div></div>
  <div class="field"><%= f.label :budget_yen, "当初予算（円）" %><%= f.number_field :budget_yen, min: 0, max: 999999999999, step: 1, placeholder: "例：4500000" %><small>予算の記録のみ。見積の集計は次の開発段階で追加します。</small></div>
  <%= f.submit "保存して準備を進める", class: "button primary" %>
<% end %>
