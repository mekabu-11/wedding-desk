<%= render "shared/errors", record: household %>
<%= form_with model: household, class: "form-stack" do |f| %><%= f.hidden_field :lock_version %><div class="field"><%= f.label :name, "世帯名" %><%= f.text_field :name, required: true, maxlength: 150, placeholder: "例：山田家" %></div><div class="field"><%= f.label :cash_gift_rule_id, "ご祝儀区分" %><%= f.select :cash_gift_rule_id, [["未設定", ""]] + cash_gift_rules.map { |rule| ["#{rule.label}（#{number_to_currency(rule.default_amount_yen, unit: "", precision: 0)}円）", rule.id] } %><small>区分は候補です。チェックした時点で世帯につき1件のご祝儀明細を作成します。</small></div><div class="field"><%= f.label :notes, "メモ" %><%= f.text_area :notes, rows: 3, maxlength: 2000 %></div><% if household.cash_gift_rule || cash_gift_rules.any? %><label class="check-label"><%= check_box_tag :cash_gift, "1", household.cash_gift_budget_item.present? %><span>ご祝儀の概算明細を作成・更新する（既存の確定額は変更しません）</span></label><% end %><%= f.submit household.persisted? ? "保存する" : "世帯を追加", class: "button primary" %><% end %>
