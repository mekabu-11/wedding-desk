<%= render "shared/errors", record: money_movement %><%= form_with model: [budget_item, money_movement], class: "form-stack" do |f| %><%= f.hidden_field :lock_version %><div class="field"><%= f.label :occurred_on, "日付" %><%= f.date_field :occurred_on, required: true %></div><div class="field"><%= f.label :kind, "種類" %><%= f.select :kind, MoneyMovement::KINDS.map { |k,v| [v,k] } %></div><div class="field"><%= f.label :amount_yen, "金額（円）" %><%= f.number_field :amount_yen, required: true, min: 1, step: 1 %></div><div class="field"><%= f.label :note, "メモ" %><%= f.text_area :note, rows: 3, maxlength: 1000 %></div><%= f.hidden_field :idempotency_key, value: (money_movement.idempotency_key || SecureRandom.uuid) %><p class="callout">返金・返戻は、先に登録された支払い・受取の合計を超えられません。</p><%= f.submit money_movement.persisted? ? "保存する" : "履歴を追加", class: "button primary" %><% end %>
