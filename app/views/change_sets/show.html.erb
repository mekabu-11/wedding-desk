<%= link_to "← 資料", document_path(@change_set.document), class: "back-link" %>
<header class="page-heading"><div><p class="eyebrow">変更候補</p><h1>変更候補を確認する</h1><p><%= @change_set.summary.presence || "候補を準備しています。" %></p></div></header>
<section class="surface"><% if @change_set.error.present? %><div class="flash flash-alert"><%= @change_set.error %></div><% end %><% if @operations.empty? %><p class="muted">候補はまだありません。外部AI設定と資料内容を確認してください。</p><% else %><%= form_with url: apply_change_set_path(@change_set), method: :post, class: "form-stack" do %><% @operations.each do |operation| %><label class="candidate reviewed"><%= check_box_tag "operation_ids[]", operation.id, false, disabled: operation.state == "applied" %><strong><%= operation.action %> · <%= operation.entity_type %></strong><p class="micro"><%= operation.attributes_hash.except("_key").to_json %></p><% if operation.uncertainties_data.present? %><p class="micro">要確認: <%= Array(operation.uncertainties_data).join("、") %></p><% end %></label><% end %><%= submit_tag "選択した変更を反映", class: "button primary" %><% end %><% end %></section>
