<%= render "shared/errors", record: gift_set %><%= form_with model: gift_set, class: "form-stack" do |f| %><%= f.hidden_field :lock_version %><div class="field"><%= f.label :name, "セット名" %><%= f.text_field :name, required: true, maxlength: 120, placeholder: "例：親族向けセット" %></div><div class="field"><%= f.label :notes, "メモ" %><%= f.text_area :notes, rows: 2, maxlength: 1000 %></div><h2>セット内訳</h2><p class="micro">空欄の行は保存時に無視します。複数の品を追加できます。税抜の品だけ税率と丸めを合計へ反映します。</p><%= f.fields_for :gift_set_items do |item| %><div class="surface" style="padding: 17px; border-style: dashed"><div class="form-grid"><div class="field"><%= item.label :kind, "種類" %><%= item.select :kind, GiftSetItem::KINDS.map { |k,v| [v,k] } %></div><div class="field"><%= item.label :name, "品名" %><%= item.text_field :name, maxlength: 120 %></div></div><div class="form-grid"><div class="field"><%= item.label :unit_price_yen, "単価（円）" %><%= item.number_field :unit_price_yen, min: 0, step: 1 %></div><div class="field"><%= item.label :tax_basis, "税区分" %><%= item.select :tax_basis, BudgetItem::TAX_BASES.map { |k,v| [v,k] } %></div><div class="field"><%= item.label :tax_rate, "税率（%）" %><%= item.number_field :tax_rate, min: 0, max: 100, step: 0.01 %></div><div class="field"><%= item.label :rounding, "丸め" %><%= item.select :rounding, GiftSetItem::ROUNDINGS.map { |k,v| [v,k] }, selected: (item.object.rounding || "floor") %></div></div><%= item.hidden_field :id %><%= item.check_box :_destroy if item.object.persisted? %><%= item.label :_destroy, "この品を削除" if item.object.persisted? %></div><% end %><%= f.submit gift_set.persisted? ? "保存する" : "セットを追加", class: "button primary" %><% end %>
