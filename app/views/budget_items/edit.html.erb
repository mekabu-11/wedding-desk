<%= link_to "← お金", budget_items_path, class: "back-link" %><header class="page-heading"><div><h1>金額を編集する</h1><p><%= @budget_item.payment_status %> · 履歴 <%= @budget_item.money_movements.size %>件</p></div></header><section class="surface narrow"><%= render "form", budget_item: @budget_item %><% if @budget_item.money_movements.any? %><section style="margin-top: 24px"><h2>入出金履歴</h2><% @budget_item.money_movements.order(:occurred_on, :id).each do |movement| %><p style="margin-top: 10px"><%= movement.occurred_on %> · <%= MoneyMovement::KINDS[movement.kind] %> · <%= number_to_currency(movement.amount_yen, unit: "", precision: 0) %>円 <%= button_to "削除", budget_item_money_movement_path(@budget_item, movement), method: :delete, class: "button danger-button", style: "padding: 4px 8px; min-height: 30px; display:inline-flex" %></p><% end %></section><% end %><%= button_to "この明細を削除", budget_item_path(@budget_item), method: :delete, class: "button danger-button", style: "margin-top: 16px", form: { data: { turbo_confirm: "削除しますか？" } } %></section>
