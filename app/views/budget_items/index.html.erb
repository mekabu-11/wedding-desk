<header class="page-heading"><div><p class="eyebrow">収支</p><h1><span class="page-title"><%= ui_icon(:money, size: 25) %><span>お金</span></span></h1><p>費用と入出金を、項目ごとの状態で確認できます。</p></div><%= link_to new_budget_item_path, class: "button primary" do %><%= ui_icon(:plus, size: 17) %><span>金額を追加</span><% end %></header>
<div class="metrics"><div><span>総支出</span><strong><%= number_to_currency(@expense_total || 0, unit: "", precision: 0) %><small>円</small></strong></div><div><span>総収入</span><strong><%= number_to_currency(@income_total || 0, unit: "", precision: 0) %><small>円</small></strong></div><div><span>負担見込み</span><strong><%= number_to_currency(@burden_estimate, unit: "", precision: 0) %><small>円</small></strong><small>金額未確認<%= @unknown_count %>件を除く</small></div></div>
<% budget_filters_active = [@direction, @certainty, @payment_status_filter].count(&:present?) %>
<details class="filter-disclosure" <%= "open" if budget_filters_active.positive? %>><summary>絞り込み<% if budget_filters_active.positive? %><span class="filter-count"><%= budget_filters_active %>件適用中</span><% end %></summary><%= form_with url: budget_items_path, method: :get, class: "filter-form" do |f| %><div class="field"><%= f.label :direction, "収支" %><%= f.select :direction, [["すべて", ""]] + BudgetItem::DIRECTIONS.map { |k,v| [v,k] }, selected: @direction %></div><div class="field"><%= f.label :certainty, "金額の状態" %><%= f.select :certainty, [["すべて", ""]] + BudgetItem::CERTAINTIES.map { |k,v| [v,k] }, selected: @certainty %></div><div class="field"><%= f.label :payment_status, "支払い・受取" %><%= f.select :payment_status, [["すべて", ""]] + BudgetItem::PAYMENT_STATUS_FILTERS.map { |k,v| [v,k] }, selected: @payment_status_filter %></div><div class="filter-actions"><%= f.submit "絞り込む", class: "button secondary" %><%= link_to "条件をクリア", budget_items_path, class: "text-link" if budget_filters_active.positive? %></div><% end %></details>
<p class="muted task-result-count"><%= @total_count %>件</p><section class="surface list-surface"><% if @budget_items.empty? %><div class="empty-state"><h2>金額はまだありません</h2><p>手動で項目名・金額・概算／確定を入力できます。</p><%= link_to "金額を追加", new_budget_item_path, class: "button primary" %></div><% end %><% @budget_items.each do |item| %><article class="task-row budget-list-row"><div class="row-content"><h3><%= item.title %></h3><div class="status-badge-row"><%= status_badge BudgetItem::DIRECTIONS.fetch(item.direction), tone: item.direction == "income" ? :positive : :warning %><%= status_badge BudgetItem::CERTAINTIES.fetch(item.certainty), tone: item.certainty == "confirmed" ? :positive : :warning %><%= status_badge item.payment_status, tone: budget_payment_tone(item.payment_status_key) %></div><div class="row-meta-text"><%= item.amount_yen.nil? ? "金額未確認" : number_to_currency(item.amount_yen, unit: "", precision: 0) + "円" %><% if item.remaining_amount %> · 残り <%= number_to_currency(item.remaining_amount, unit: "", precision: 0) %>円<% end %></div></div><div class="task-actions"><%= link_to "編集", edit_budget_item_path(item), class: "button secondary" %><%= link_to "履歴を追加", new_budget_item_money_movement_path(item), class: "button secondary" %></div></article><% end %></section><%= render "shared/pagination", total: @total_count, page: @page %>
