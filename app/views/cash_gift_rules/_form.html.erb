<%= render "shared/errors", record: cash_gift_rule %><%= form_with model: cash_gift_rule, class: "form-stack" do |f| %><%= f.hidden_field :lock_version %><div class="field"><%= f.label :label, "区分名" %><%= f.text_field :label, required: true, maxlength: 80, placeholder: "例：親族" %></div><div class="field"><%= f.label :default_amount_yen, "初期提案額（円）" %><%= f.number_field :default_amount_yen, required: true, min: 0, step: 1 %><small>既存の確定済みご祝儀明細はこの変更で上書きしません。</small></div><%= f.submit cash_gift_rule.persisted? ? "保存する" : "区分を追加", class: "button primary" %><% end %>
