<%= render "shared/errors", record: cash_gift_rule %><%= form_with model: cash_gift_rule, class: "form-stack" do |f| %><%= f.hidden_field :lock_version %><div class="field"><%= f.label :label, "区分名" %><%= f.text_field :label, required: true, maxlength: 80, placeholder: "例：親族" %></div><div class="field"><%= f.label :default_amount_yen, "初期提案額（円）" %><%= f.number_field :default_amount_yen, required: true, min: 0, step: 1 %><small>既存の確定済みご祝儀明細はこの変更で上書きしません。</small></div><details class="settings-section"><summary>世帯未設定時の自動適用</summary><p class="micro">世帯が未設定の出席ゲストへ、この区分を候補として自動適用します。世帯に手動設定した区分がある場合はそちらを優先します。</p><div class="field"><%= f.label :fallback_attribute, "適用する属性" %><%= f.select :fallback_attribute, CashGiftRule::FALLBACK_ATTRIBUTES.map { |k,v| [v,k] }, {}, data: { cash_gift_fallback_attribute: true } %></div><div class="field" data-cash-gift-fallback-value <%= "hidden" unless cash_gift_rule.fallback? %>><%= f.label :fallback_value, "属性の値" %><%= f.select :fallback_value, Guest::SIDES.map { |k,v| [v,k] }, { include_blank: "選択してください" }, { data: { fallback_options: "side" }, hidden: cash_gift_rule.fallback_attribute != "side", disabled: cash_gift_rule.fallback_attribute != "side" } %><%= f.text_field :fallback_value, maxlength: 150, placeholder: "例：友人", data: { fallback_options: "relationship" }, hidden: cash_gift_rule.fallback_attribute != "relationship", disabled: cash_gift_rule.fallback_attribute != "relationship" %><%= f.select :fallback_value, Guest::AGE_GROUPS.map { |k,v| [v,k] }, { include_blank: "選択してください" }, { data: { fallback_options: "age_group" }, hidden: cash_gift_rule.fallback_attribute != "age_group", disabled: cash_gift_rule.fallback_attribute != "age_group" } %></div></details><%= f.submit cash_gift_rule.persisted? ? "保存する" : "区分を追加", class: "button primary" %><% end %>
