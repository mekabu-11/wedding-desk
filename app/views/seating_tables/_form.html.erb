<%= render "shared/errors", record: seating_table %><%= form_with model: seating_table, class: "form-stack" do |f| %><%= f.hidden_field :lock_version %><div class="field"><%= f.label :label, "卓名" %><%= f.text_field :label, required: true, maxlength: 80, placeholder: "例：A" %></div><div class="field"><%= f.label :capacity, "定員" %><%= f.number_field :capacity, min: 1, step: 1 %><small>任意。席の幾何配置は扱わず、卓ごとのメンバー一覧で管理します。</small></div><%= f.submit seating_table.persisted? ? "保存する" : "卓を追加", class: "button primary" %><% end %>
