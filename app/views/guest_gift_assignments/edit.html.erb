<%= link_to "← 引き出物", guests_path(tab: "gifts"), class: "back-link" %>
<header class="page-heading"><div><h1>個人の引き出物を編集する</h1><p><%= @guest_gift_assignment.guest.name %> · <%= @guest_gift_assignment.gift_set.name %></p></div></header>
<section class="surface narrow"><%= render "form", guest_gift_assignment: @guest_gift_assignment, guests: @guests, gift_sets: @gift_sets %><%= button_to "個人割当を解除", guest_gift_assignment_path(@guest_gift_assignment), method: :delete, class: "button danger-button", style: "margin-top: 16px", form: { data: { turbo_confirm: "個人割当を解除しますか？" } } %></section>
