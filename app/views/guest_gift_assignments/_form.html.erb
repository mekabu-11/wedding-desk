<%= render "shared/errors", record: guest_gift_assignment %>
<%= form_with model: guest_gift_assignment, class: "form-stack" do |f| %>
  <%= f.hidden_field :lock_version %>
  <div class="field"><%= f.label :guest_id, "個人" %><%= f.select :guest_id, guests.map { |guest| [guest.household ? "#{guest.name}（#{guest.household.name}）" : "#{guest.name}（世帯未設定）", guest.id] }, { include_blank: "選択してください" }, required: true %></div>
  <div class="field"><%= f.label :gift_set_id, "引き出物セット" %><%= f.select :gift_set_id, gift_sets.map { |gift_set| ["#{gift_set.name}（#{number_to_currency(gift_set.total_price_yen, unit: "", precision: 0)}円）", gift_set.id] }, { include_blank: "選択してください" }, required: true %></div>
  <div class="form-grid"><div class="field"><%= f.label :quantity, "数量" %><%= f.number_field :quantity, required: true, min: 1, step: 1 %></div><div class="field"><%= f.label :included, "集計" %><%= f.select :included, [["集計する", true], ["除外", false]] %></div></div>
  <div class="field"><%= f.label :notes, "メモ" %><%= f.text_area :notes, rows: 2, maxlength: 1000 %></div>
  <p class="callout">世帯の標準セットとは別に、この個人へ渡す引き出物を設定します。保存すると個人単位の費用を1件作成します。</p>
  <%= f.submit guest_gift_assignment.persisted? ? "保存する" : "個人に割り当てる", class: "button primary" %>
<% end %>
