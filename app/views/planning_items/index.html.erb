<header class="page-heading"><div><p class="eyebrow">決めること</p><h1><span class="page-title"><%= ui_icon(:planning, size: 25) %><span>検討・決定</span></span></h1><p>候補を比べ、採用した内容と費用を一緒に管理します。</p></div><%= link_to new_planning_item_path, class: "button primary" do %><%= ui_icon(:plus, size: 17) %><span>項目を追加</span><% end %></header>
<nav class="tabs" aria-label="検討カテゴリ"><%= link_to "すべて", planning_items_path, class: @category.nil? ? "selected" : "" %><% PlanningItem::CATEGORIES.each do |key, label| %><%= link_to label, planning_items_path(category: key), class: @category == key ? "selected" : "" %><% end %></nav>
<% planning_filters_active = @status.present? %>
<details class="filter-disclosure" <%= "open" if planning_filters_active %>><summary>絞り込み<% if planning_filters_active %><span class="filter-count">1件適用中</span><% end %></summary><%= form_with url: planning_items_path, method: :get, class: "filter-form" do |f| %><%= hidden_field_tag :category, @category %><div class="field"><%= f.label :status, "候補の状態" %><%= f.select :status, [["すべて", ""]] + PlanningOption::STATUSES.map { |k,v| [v,k] }, selected: @status %></div><div class="filter-actions"><%= f.submit "絞り込む", class: "button secondary" %><%= link_to "条件をクリア", planning_items_path(category: @category), class: "text-link" if planning_filters_active %></div><% end %></details>
<p class="muted task-result-count"><%= @total_count %>件</p>
<section class="surface list-surface"><% if @planning_items.empty? %><div class="empty-state"><h2>検討項目はまだありません</h2><p>演出やBGMなど、決めることを項目単位で追加できます。</p><%= link_to "項目を追加", new_planning_item_path, class: "button primary" %></div><% end %><% @planning_items.each do |item| %><%= link_to planning_item_path(item), class: "task-row planning-list-row" do %><div class="row-content"><h3><%= item.title %></h3><div class="status-badge-row"><%= status_badge PlanningItem::CATEGORIES.fetch(item.category), tone: :muted %><%= status_badge "#{item.planning_options.size}候補", tone: item.planning_options.any? ? :blue : :muted %><%= status_badge "採用あり", tone: :positive if item.planning_options.any?(&:selected?) %></div></div><span class="row-arrow">→</span><% end %><% end %></section>
<%= render "shared/pagination", total: @total_count, page: @page %>
