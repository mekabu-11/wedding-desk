<%= render "shared/errors", record: planning_item %><%= form_with model: planning_item, class: "form-stack" do |f| %><%= f.hidden_field :lock_version %><div class="field"><%= f.label :title, "項目名" %><%= f.text_field :title, required: true, maxlength: 150, placeholder: "例：入場BGM" %></div><div class="form-grid"><div class="field"><%= f.label :category, "カテゴリ" %><%= f.select :category, PlanningItem::CATEGORIES.map { |k,v| [v,k] } %></div><div class="field"><%= f.label :position, "表示順" %><%= f.number_field :position, min: 0, step: 1 %></div></div><div class="field"><%= f.label :notes, "メモ" %><%= f.text_area :notes, rows: 4, maxlength: 3000 %></div><%= f.submit planning_item.persisted? ? "保存する" : "項目を追加", class: "button primary" %><% end %>
