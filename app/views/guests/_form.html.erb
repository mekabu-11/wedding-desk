<%= render "shared/errors", record: guest %>
<%= form_with model: guest, class: "form-stack" do |f| %><%= f.hidden_field :lock_version %>
<div class="field"><%= f.label :name, "氏名" %><%= f.text_field :name, required: true, maxlength: 150 %></div>
<div class="form-grid"><div class="field"><%= f.label :side, "側" %><%= f.select :side, Guest::SIDES.map { |k,v| [v,k] } %></div><div class="field"><%= f.label :age_group, "区分" %><%= f.select :age_group, Guest::AGE_GROUPS.map { |k,v| [v,k] } %></div></div>
<div class="form-grid"><div class="field"><%= f.label :attendance, "出欠" %><%= f.select :attendance, Guest::ATTENDANCES.map { |k,v| [v,k] } %></div><div class="field"><%= f.label :invitation_status, "招待状態" %><%= f.select :invitation_status, [["未設定", "unknown"]] + Guest::INVITATION_STATUSES.except("unknown").map { |k,v| [v,k] } %></div></div>
<div class="form-grid"><div class="field"><%= f.label :gender, "性別" %><%= f.select :gender, [["未設定", ""]] + Guest::GENDERS.except("unknown").map { |k,v| [v,k] } %></div><div class="field"><span class="field-label">役割（複数可）</span><%= hidden_field_tag "guest[roles][]", "" %><% Guest::ROLES.each do |key, label| %><label class="check-label"><%= check_box_tag "guest[roles][]", key, Array(guest.roles).include?(key) %><span><%= label %></span></label><% end %></div></div>
<div class="form-grid"><div class="field"><%= f.label :household_id, "世帯" %><%= f.select :household_id, [["未設定", ""]] + households.map { |h| [h.name, h.id] } %></div><div class="field"><%= f.label :seating_table_id, "卓" %><%= f.select :seating_table_id, [["未設定", ""]] + seating_tables.map { |t| ["卓#{t.label}", t.id] } %></div></div>
<div class="field"><%= f.label :relationship, "続柄・関係" %><%= f.text_field :relationship, maxlength: 150 %></div><div class="field"><%= f.label :allergies, "アレルギー" %><%= f.text_area :allergies, rows: 2, maxlength: 1000 %></div><div class="field"><%= f.label :notes, "メモ" %><%= f.text_area :notes, rows: 3, maxlength: 2000 %></div>
<%= f.submit guest.persisted? ? "保存する" : "ゲストを追加", class: "button primary" %><% end %>
