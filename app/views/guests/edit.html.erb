<%= link_to "← ゲスト", guests_path(tab: "individuals"), class: "back-link" %><header class="page-heading"><div><h1>ゲストを編集する</h1><p>個人情報と出欠・配席を更新します。</p></div></header><section class="surface narrow"><%= render "form", guest: @guest, households: @households, seating_tables: @seating_tables %><%= button_to "このゲストを削除", guest_path(@guest), method: :delete, class: "button danger-button", style: "margin-top: 16px", form: { data: { turbo_confirm: "このゲストを削除しますか？" } } %></section><section class="surface narrow" style="margin-top:24px"><h2>最近の変更</h2><% if @change_events.empty? %><p class="muted">変更履歴はありません。</p><% else %><% @change_events.each do |event| %><p class="micro"><%= l event.created_at, format: :short %> · <%= event.action %></p><% end %><% end %></section>
