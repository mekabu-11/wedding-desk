<header class="page-heading"><div><p class="eyebrow">招待する人</p><h1><span class="page-title"><%= ui_icon(:guests, size: 25) %><span>ゲスト</span></span></h1><p>個人・世帯・席次・引き出物を同じ一覧から管理します。</p></div><%= link_to new_guest_path, class: "button primary" do %><%= ui_icon(:plus, size: 17) %><span>ゲストを追加</span><% end %></header>
<nav class="tabs" aria-label="ゲスト管理"><%= link_to "個人", guests_path(tab: "individuals"), class: @tab == "individuals" ? "selected" : "" %><%= link_to "世帯", guests_path(tab: "households"), class: @tab == "households" ? "selected" : "" %><%= link_to "席次", guests_path(tab: "seating"), class: @tab == "seating" ? "selected" : "" %><%= link_to "引き出物", guests_path(tab: "gifts"), class: @tab == "gifts" ? "selected" : "" %></nav>
<% if @tab.in?(%w[individuals households]) %><%= form_with url: guests_path, method: :get, class: "task-filters surface" do |f| %><%= hidden_field_tag :tab, @tab %><div class="field"><%= f.label :q, "Wedding内を検索" %><%= f.search_field :q, value: @search_query, placeholder: "氏名・世帯名・メモ" %></div><%= f.submit "検索", class: "button secondary" %><% end %><% if @search_truncated %><p class="micro">検索対象は先頭2,000件です。全件を確認するには条件を分けてください。</p><% end %><% end %>

<% if @tab == "individuals" %>
  <div class="section-heading"><div><p class="eyebrow">ゲスト</p><h2><%= @guests.size %>人</h2></div></div>
  <section class="surface list-surface">
    <% if @guests.empty? %><div class="empty-state"><h2>ゲストはまだいません</h2><p>招待する人を個人単位で登録できます。世帯は後から割り当てられます。</p><%= link_to "ゲストを追加", new_guest_path, class: "button primary" %></div><% end %>
    <% @guests.each do |guest| %><%= link_to edit_guest_path(guest), class: "task-row" do %><div class="row-content"><h3><%= guest.name %></h3><div class="micro"><%= Guest::SIDES[guest.side] %> <span class="separator">/</span> <%= Guest::ATTENDANCES[guest.attendance] %> <span class="separator">/</span> <%= guest.household&.name || "世帯未設定" %><% if guest.seating_table %> <span class="separator">/</span> 卓<%= guest.seating_table.label %><% end %></div></div><span class="row-arrow">→</span><% end %><% end %>
  </section>
  <%= render "shared/pagination", total: @total_count, page: @page %>
<% elsif @tab == "households" %>
  <div class="section-heading"><div><p class="eyebrow">世帯</p><h2>世帯</h2></div><div class="task-actions"><%= link_to "ご祝儀区分を設定", new_cash_gift_rule_path, class: "button secondary" %><%= link_to "世帯を追加", new_household_path, class: "button primary" %></div></div>
  <section class="surface list-surface">
    <% if @households.empty? %><div class="empty-state"><h2>世帯はまだありません</h2><p>ご祝儀と引き出物の単位になる世帯を登録します。</p><%= link_to "世帯を追加", new_household_path, class: "button primary" %></div><% end %>
    <% @households.each do |household| %><%= link_to edit_household_path(household), class: "task-row" do %><div class="row-content"><h3><%= household.name %></h3><% cash_gift = @cash_gift_budget_items[household.id] %><div class="micro"><%= household.code %> <span class="separator">/</span> <%= household.guests.size %>人 <span class="separator">/</span> ご祝儀：<%= cash_gift&.amount_yen ? number_to_currency(cash_gift.amount_yen, unit: "", precision: 0) + "円" : "未登録" %></div></div><span class="row-arrow">→</span><% end %><% end %>
  </section>
  <section class="surface" style="margin-top:24px"><div class="section-heading"><div><p class="eyebrow">ご祝儀の目安</p><h2>ご祝儀区分</h2></div></div><% if @cash_gift_rules.empty? %><p class="muted">世帯ごとに金額候補を提案する区分を追加できます。</p><% else %><% @cash_gift_rules.each do |rule| %><p><%= link_to "#{rule.label} · #{number_to_currency(rule.default_amount_yen, unit: "", precision: 0)}円", edit_cash_gift_rule_path(rule) %></p><% end %><% end %></section>
  <%= render "shared/pagination", total: @total_count, page: @page %>
<% elsif @tab == "seating" %>
  <div class="section-heading"><div><p class="eyebrow">席次</p><h2>席次</h2></div><%= link_to "卓を追加", new_seating_table_path, class: "button primary" %></div>
  <section class="surface list-surface"><% if @seating_tables.empty? %><div class="empty-state"><h2>卓はまだありません</h2><p>出席ゲストを卓ごとのメンバー一覧で管理します。</p><%= link_to "卓を追加", new_seating_table_path, class: "button primary" %></div><% end %><% @seating_tables.each do |table| %><%= link_to edit_seating_table_path(table), class: "task-row" do %><div class="row-content"><h3>卓 <%= table.label %></h3><div class="micro"><%= table.guests.size %>人<%= " / 定員#{table.capacity}人" if table.capacity %> · <%= table.guests.select(&:attendance).count { |guest| guest.attendance == "attending" } %>人出席</div></div><span class="row-arrow">→</span><% end %><% end %></section>
<% else %>
  <div class="section-heading"><div><p class="eyebrow">引き出物</p><h2>引き出物</h2></div><div class="task-actions"><%= link_to "セットを設定", new_gift_set_path, class: "button secondary" %><%= link_to "世帯へ割り当て", new_gift_assignment_path, class: "button primary" %></div></div>
  <section class="surface"><h2>セット設定</h2><p class="muted" style="margin:8px 0 17px">セットの価格は割当時にBudgetItemへ1件だけ作成します。世帯人数は自動で掛けません。</p><% if @gift_sets.empty? %><p class="muted">引き出物セットはまだありません。</p><% else %><% @gift_sets.each do |set| %><p><%= link_to "#{set.name} · #{number_to_currency(set.total_price_yen, unit: "", precision: 0)}円", edit_gift_set_path(set) %></p><% end %><% end %></section>
  <section class="surface list-surface" style="margin-top:24px"><% if @gift_assignments.empty? %><div class="empty-state"><h2>割当はまだありません</h2><p>出席世帯へ1セットを承認して割り当てます。</p><%= link_to "世帯へ割り当て", new_gift_assignment_path, class: "button primary" %></div><% end %><% @gift_assignments.each do |assignment| %><%= link_to edit_gift_assignment_path(assignment), class: "task-row" do %><div class="row-content"><h3><%= assignment.household.name %> · <%= assignment.gift_set.name %></h3><div class="micro"><%= assignment.quantity %>セット · <%= assignment.included? ? "集計する" : "除外" %> · BudgetItem <%= assignment.budget_item&.amount_yen ? number_to_currency(assignment.budget_item.amount_yen, unit: "", precision: 0) + "円" : "未作成" %></div></div><span class="row-arrow">→</span><% end %><% end %></section>
<% end %>
