<header class="page-heading"><div><p class="eyebrow">招待する人</p><h1><span class="page-title"><%= ui_icon(:guests, size: 25) %><span>ゲスト</span></span></h1><p>個人・世帯・席次・引き出物・食事を同じ一覧から管理します。</p></div><%= link_to new_guest_path, class: "button primary" do %><%= ui_icon(:plus, size: 17) %><span>ゲストを追加</span><% end %></header>
<nav class="tabs guest-tabs" aria-label="ゲスト管理"><%= link_to "個人", guests_path(tab: "individuals"), class: @tab == "individuals" ? "selected" : "" %><%= link_to "世帯", guests_path(tab: "households"), class: @tab == "households" ? "selected" : "" %><%= link_to "席次", guests_path(tab: "seating"), class: @tab == "seating" ? "selected" : "" %><%= link_to "引き出物", guests_path(tab: "gifts"), class: @tab == "gifts" ? "selected" : "" %><%= link_to "食事", guests_path(tab: "meals"), class: @tab == "meals" ? "selected" : "" %></nav>
<% if @tab.in?(%w[individuals households]) %>
  <% guest_filters_active = [@search_query, @attendance, @side, @invitation_status, @household_filter, @role].count(&:present?) %>
  <details class="filter-disclosure" <%= "open" if guest_filters_active.positive? %>>
    <summary>絞り込み<% if guest_filters_active.positive? %><span class="filter-count"><%= guest_filters_active %>件適用中</span><% end %></summary>
    <%= form_with url: guests_path, method: :get, class: "filter-form" do |f| %>
      <%= hidden_field_tag :tab, @tab %>
      <div class="field"><%= f.label :q, "キーワード" %><%= f.search_field :q, value: @search_query, placeholder: "氏名・世帯名・メモ" %></div>
      <% if @tab == "individuals" %>
        <div class="field"><%= f.label :attendance, "出欠" %><%= f.select :attendance, [["すべて", ""]] + Guest::ATTENDANCES.map { |k, v| [v, k] }, selected: @attendance %></div>
        <div class="field"><%= f.label :side, "側" %><%= f.select :side, [["すべて", ""]] + Guest::SIDES.map { |k, v| [v, k] }, selected: @side %></div>
        <div class="field"><%= f.label :invitation_status, "招待状態" %><%= f.select :invitation_status, [["すべて", ""]] + Guest::INVITATION_STATUSES.map { |k, v| [v, k] }, selected: @invitation_status %></div>
        <div class="field"><%= f.label :household, "世帯" %><%= f.select :household, [["すべて", ""], ["世帯あり", "assigned"], ["世帯未設定", "unassigned"]], selected: @household_filter %></div>
        <div class="field"><%= f.label :role, "役割" %><%= f.select :role, [["すべて", ""]] + Guest::ROLES.map { |k, v| [v, k] }, selected: @role %></div>
      <% end %>
      <div class="filter-actions"><%= f.submit "絞り込む", class: "button secondary" %><%= link_to "条件をクリア", guests_path(tab: @tab), class: "text-link" if guest_filters_active.positive? %></div>
    <% end %>
  </details>
  <% if @search_truncated %><p class="micro filter-note">検索対象は先頭2,000件です。条件を追加して絞り込んでください。</p><% end %>
<% end %>

<% if @tab == "individuals" %>
  <div class="section-heading"><div><p class="eyebrow">ゲスト</p><h2><%= @guests.size %>人</h2></div></div>
  <section class="surface list-surface">
    <% if @guests.empty? %><div class="empty-state"><h2>ゲストはまだいません</h2><p>招待する人を個人単位で登録できます。世帯は後から割り当てられます。</p><%= link_to "ゲストを追加", new_guest_path, class: "button primary" %></div><% end %>
    <% @guests.each do |guest| %><%= link_to edit_guest_path(guest), class: "task-row guest-list-row" do %><div class="row-content"><h3><%= guest.name %></h3><div class="status-badge-row"><%= status_badge Guest::SIDES.fetch(guest.side, "未設定"), tone: guest_side_tone(guest.side) %><%= status_badge Guest::ATTENDANCES.fetch(guest.attendance, "未回答"), tone: guest_attendance_tone(guest.attendance) %><%= status_badge Guest::INVITATION_STATUSES.fetch(guest.invitation_status.presence || "unknown", "未設定"), tone: guest_invitation_tone(guest.invitation_status.presence || "unknown") %></div><div class="row-meta-text"><%= guest.household&.name || "世帯未設定" %><% if guest.seating_table %> · 卓<%= guest.seating_table.label %><% end %></div></div><span class="row-arrow">→</span><% end %><% end %>
  </section>
  <%= render "shared/pagination", total: @total_count, page: @page %>
<% elsif @tab == "households" %>
  <div class="section-heading"><div><p class="eyebrow">世帯</p><h2>世帯</h2></div><div class="task-actions"><%= link_to "ご祝儀区分を設定", new_cash_gift_rule_path, class: "button secondary" %><%= link_to "世帯を追加", new_household_path, class: "button primary" %></div></div>
  <section class="surface list-surface">
    <% if @households.empty? %><div class="empty-state"><h2>世帯はまだありません</h2><p>ご祝儀と引き出物の単位になる世帯を登録します。</p><%= link_to "世帯を追加", new_household_path, class: "button primary" %></div><% end %>
    <% @households.each do |household| %><%= link_to edit_household_path(household), class: "task-row" do %><div class="row-content"><h3><%= household.name %></h3><% cash_gift = @cash_gift_budget_items[household.id] %><div class="micro"><%= household.guests.size %>人 <span class="separator">/</span> ご祝儀：<%= cash_gift&.amount_yen ? number_to_currency(cash_gift.amount_yen, unit: "", precision: 0) + "円" : "未登録" %></div></div><span class="row-arrow">→</span><% end %><% end %>
  </section>
  <section class="surface" style="margin-top:24px"><div class="section-heading"><div><p class="eyebrow">ご祝儀の目安</p><h2>ご祝儀区分</h2></div></div><% if @cash_gift_rules.empty? %><p class="muted">世帯ごとに金額候補を提案する区分を追加できます。</p><% else %><% @cash_gift_rules.each do |rule| %><p><%= link_to "#{rule.label} · #{number_to_currency(rule.default_amount_yen, unit: "", precision: 0)}円", edit_cash_gift_rule_path(rule) %></p><% end %><% end %></section>
  <%= render "shared/pagination", total: @total_count, page: @page %>
<% elsif @tab == "seating" %>
  <div class="section-heading"><div><p class="eyebrow">席次</p><h2>席次</h2></div><div class="task-actions"><%= link_to "卓の位置を編集", layout_seating_tables_path, class: "button secondary" if @seating_tables.any? %><%= link_to "卓を追加", new_seating_table_path, class: "button primary" %></div></div>
  <section class="surface list-surface"><% if @seating_tables.empty? %><div class="empty-state"><h2>卓はまだありません</h2><p>出席ゲストを卓ごとのメンバー一覧で管理します。</p><%= link_to "卓を追加", new_seating_table_path, class: "button primary" %></div><% end %><% @seating_tables.each do |table| %><%= link_to edit_seating_table_path(table), class: "task-row" do %><div class="row-content"><h3>卓 <%= table.label %></h3><div class="micro"><%= table.guests.size %>人<%= " / 定員#{table.capacity}人" if table.capacity %> · <%= table.guests.select(&:attendance).count { |guest| guest.attendance == "attending" } %>人出席</div></div><span class="row-arrow">→</span><% end %><% end %></section>
<% elsif @tab == "meals" %>
  <div class="section-heading"><div><p class="eyebrow">食事</p><h2>食事セット</h2></div><%= link_to "食事セットを追加", new_meal_set_path, class: "button primary" %></div>
  <section class="surface"><p class="muted" style="margin-bottom:17px">標準セットを大人・子ども・全員に設定すると、出席ゲストへ自動で適用します。個別の変更はゲスト編集から行えます。</p><% if @meal_sets.empty? %><div class="empty-state"><h2>食事セットはまだありません</h2><p>大人用・子ども用などの料理セットを登録できます。</p><%= link_to "食事セットを追加", new_meal_set_path, class: "button primary" %></div><% else %><% @meal_sets.each do |set| %><%= link_to edit_meal_set_path(set), class: "task-row" do %><div class="row-content"><h3><%= set.name %></h3><div class="micro"><%= MealSet::TARGET_AGE_GROUPS.fetch(set.target_age_group) %> · <%= number_to_currency(set.unit_price_yen, unit: "", precision: 0) %>円／人 · <%= set.default_for_target? ? "標準" : "個別指定用" %> · <%= @meal_set_counts.fetch(set.id, 0) %>人</div></div><span class="row-arrow">→</span><% end %><% end %><% end %></section>
  <section class="surface" style="margin-top:24px"><h2>個別指定</h2><p class="muted" style="margin-top:8px"><%= @meal_guest_overrides.size %>人が標準セットから変更されています。</p><% if @meal_guest_overrides.any? %><% @meal_guest_overrides.each do |guest| %><p style="margin-top:10px"><%= link_to "#{guest.name} · #{guest.meal_set.name}", edit_guest_path(guest) %></p><% end %><% end %></section>
<% else %>
  <div class="section-heading"><div><p class="eyebrow">引き出物</p><h2>引き出物</h2></div><div class="task-actions"><%= link_to "セットを設定", new_gift_set_path, class: "button secondary" %><%= link_to "個人に割り当て", new_guest_gift_assignment_path, class: "button secondary" %><%= link_to "世帯へ割り当て", new_gift_assignment_path, class: "button primary" %></div></div>
  <section class="surface"><h2>セット設定</h2><p class="muted" style="margin:8px 0 17px">セットの価格は割当時に費用として1件だけ作成します。世帯人数は自動で掛けません。</p><% if @gift_sets.empty? %><p class="muted">引き出物セットはまだありません。</p><% else %><% @gift_sets.each do |set| %><p><%= link_to "#{set.name} · #{number_to_currency(set.total_price_yen, unit: "", precision: 0)}円", edit_gift_set_path(set) %></p><% end %><% end %></section>
  <section class="surface list-surface" style="margin-top:24px"><% if @gift_assignments.empty? && @guest_gift_assignments.empty? %><div class="empty-state"><h2>割当はまだありません</h2><p>世帯または個人へ引き出物を割り当てます。</p><%= link_to "世帯へ割り当て", new_gift_assignment_path, class: "button primary" %></div><% end %><% @gift_assignments.each do |assignment| %><%= link_to edit_gift_assignment_path(assignment), class: "task-row" do %><div class="row-content"><h3><%= assignment.household.name %> · <%= assignment.gift_set.name %></h3><div class="micro">世帯 · <%= assignment.quantity %>セット · <%= assignment.included? ? "集計する" : "除外" %> · 費用 <%= assignment.budget_item&.amount_yen ? number_to_currency(assignment.budget_item.amount_yen, unit: "", precision: 0) + "円" : "未作成" %></div></div><span class="row-arrow">→</span><% end %><% end %><% @guest_gift_assignments.each do |assignment| %><%= link_to edit_guest_gift_assignment_path(assignment), class: "task-row" do %><div class="row-content"><h3><%= assignment.guest.name %> · <%= assignment.gift_set.name %></h3><div class="micro">個人 · <%= assignment.quantity %>セット · <%= assignment.included? ? "集計する" : "除外" %> · 費用 <%= assignment.budget_item&.amount_yen ? number_to_currency(assignment.budget_item.amount_yen, unit: "", precision: 0) + "円" : "未作成" %></div></div><span class="row-arrow">→</span><% end %><% end %></section>
<% end %>
