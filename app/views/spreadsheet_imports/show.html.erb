<%= link_to "← Excel移行", new_spreadsheet_import_path, class: "back-link" %>
<header class="page-heading"><div><p class="eyebrow">取り込み内容</p><h1>Excel統合プレビュー</h1><p><%= @batch.row_count %>行・警告<%= @batch.warning_count %>件。順番を固定して反映します。</p></div></header>
<% if @batch.state == "committed" %><div class="flash"><%= @batch.imported_count %>行を反映しました。<%= @batch.skipped_count %>行は重複のため保持しました。</div><%= link_to "やることを見る", tasks_path, class: "button primary" %><% else %>
<section class="surface narrow"><h2>担当A/Bの確認</h2><p class="muted">Excelの担当名を、現在のWeddingの本人A・本人Bへ割り当てます。</p><%= form_with url: spreadsheet_import_path(@batch), method: :patch, class: "form-stack" do %><% @labels.each_with_index do |label, index| %><div class="field"><%= label_tag "mapping_#{index}", label.presence || "担当名なし" %><%= select_tag "mapping[#{label}]", options_for_select([["選択してください", ""]] + Task.assignee_options(@batch.wedding)), id: "mapping_#{index}", required: true %></div><% end %><label class="check-label"><%= check_box_tag :confirmed, "1", false, required: true %><span>マスタ→世帯→ゲスト→引き出物→収支→タスク→BGMの順で反映すること、要確認の金額・日付・数式行を確認しました。</span></label><%= submit_tag "確認して反映", class: "button primary" %><% end %></section><% end %>
<section class="import-preview"><h2>行別プレビュー</h2><% @rows.each do |row| %><article class="surface import-row"><h3><%= row.row_kind %> · <%= row.sheet_name %> <%= row.row_number %>行目</h3><p class="muted"><%= row.state %> · <%= row.original_data["title"] || row.original_data["name"] || row.original_data["label"] || row.original_data["scene"] %></p><% Array(row.warnings).each do |warning| %><p class="flash flash-alert"><%= warning %></p><% end %><% if row.error.present? %><p class="flash flash-alert"><%= row.error %></p><% end %></article><% end %></section>
